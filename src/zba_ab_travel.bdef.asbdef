managed;

strict ( 2 );

//Root Behaviour Entity
define behavior for zba_ab_travel alias Travel
implementation in class zbp_ba_ab_travel unique
//Tell the RAP that is should WRITE,UPDATE,MODIFY,data from Which Table
persistent table /dmo/travel_m
//How the data will be Locked ENQUEUE,DEQUEUE - if the travel data is locked by user,
//other users parallely cannot edit its booking and supplements
lock master
//To Control data security -permission - authorization of who can create, edit, delete data
authorization master ( instance )
etag master LastChangedAt
//As a developer we want to take control of creating Travel ID
early numbering
{
  create ( authorization : global );
  update;
  delete;
  //Static feature control which says user cannot change primary key in update mode
  field ( readonly ) TravelId;

  field ( mandatory ) BeginDate,enddate,agencyid,customerid;
  //since we want to create new BO instance (Factory), Our reference is Kumar's (Instance)
  factory action copyTravel[1];

  //Here we write internal action to calculate the total cost of trave
  //we can later consume this internal action in multiple place.
  internal action reCalcTotalPrice;

  // Check the Header data during Save/Update - Validation
  validation validateHeaderData on save  { create; field CustomerId,BeginDate,EndDate,AgencyId ; }

  //determination calcTotalPrice that calls when user save, modify bookin fee
  determination calcTotalPrice on modify { field BookingFee,CurrencyCode; create; }

  //Side effects to make Fiori do a Get call to load updated data
  side effects {
    field BookingFee affects field TotalPrice;
    entity _Booking affects field TotalPrice;
    }

  //Create of booking depends on the Travel We cannot create booking without creatgn Trave
  //Dynamci Feature control create ( features : instance
  association _Booking { create ( features : instance ); }

  mapping for /dmo/travel_m{
    TravelId = travel_id;
    BeginDate = begin_date;
    EndDate = end_date;
    AgencyId = agency_id;
    CustomerId = customer_id;
    CurrencyCode = currency_code;
    TotalPrice = total_price;
    BookingFee = booking_fee;
    LastChangedAt = last_changed_at;
    LastChangedBy = last_changed_by;
    CreatedBy = created_by;
    CreatedAt = created_at;
    Description = description;
    OverallStatus = overall_status;

  }
}

define behavior for zba_ab_booking alias Booking
implementation in class zbp_ba_ab_booking unique
persistent table /dmo/booking_m
lock dependent by _Travel
authorization dependent by _Travel
etag master LastChangedAt
//Support for automatic creation of early numbering for Booking
early numbering
{
 //Use feature control if Should not edit for the cancelled Travel request
  update ( features : instance );
  delete;
  field ( readonly ) TravelId,bookingid ;

  field ( mandatory ) Carrierid,connectionid,bookingDate,customerid ;

  association _Travel;
  association _BookingSuppl { create ( features : instance ); }

   //determination calcTotalPrice that calls when user save, modify bookin fee
  determination calcTotalPriceBook on modify { field FlightPrice,CurrencyCode; create; }

  //Side effects to make Fiori do a Get call to load updated data
  side effects {
    field FlightPrice affects field _Travel.TotalPrice;
    entity _BookingSuppl affects field _Travel.TotalPrice;
    }

  mapping for /dmo/booking_m{
    travelid = travel_id;
    bookingid = booking_id;
    BookingDate = booking_date;
    CustomerId = customer_id;
    CarrierId = carrier_id;
    ConnectionId = connection_id;
    FlightDate = flight_date;
    FlightPrice = flight_price;
    CurrencyCode = currency_code;
    BookingStatus = booking_status;
    LastChangedAt = last_changed_at;
  }
}

define behavior for zba_ab_booksuppl alias BookSuppl
implementation in class zbp_ba_ab_booksuppl unique
persistent table /dmo/booksuppl_m
lock dependent by _Travel
authorization dependent by _Travel
etag master LastChangedAt
early numbering

{
  update ( features : instance );
  delete;
  field ( readonly ) TravelId, BookingId,BookingSupplementId;
  field ( mandatory ) SupplementId,currencycode,price ;

  association _Travel;
  association _Booking;
    //determination calcTotalPrice that calls when user save, modify bookin fee
  determination calcTotalPriceSuppl on modify { field Price,CurrencyCode; create; }

  //Side effects to make Fiori do a Get call to load updated data
  side effects {
    field Price affects field _Travel.TotalPrice;
    }

  mapping for /dmo/booksuppl_m{
    TravelId = travel_id;
    BookingId = booking_id;
    BookingSupplementId = booking_supplement_id;
    SupplementId = supplement_id;
    Price = price;
    CurrencyCode = currency_code;
    LastChangedAt = last_changed_at;
    }
}